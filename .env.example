# ---- backend (server only; NEVER exposed to the client) ----
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DAILY_TOKEN_CAP_USER=150000
DAILY_TOKEN_CAP_GLOBAL=2000000
FREE_JD_RUNS=2
JD_CREDIT_PRICE_INR=
UPI_QR_IMAGE_URL=
# LLM_GATEWAY_MODE: mock (default) | real. CI is always mock.
LLM_GATEWAY_MODE=mock
# optional, payments v2 only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- frontend (frontend/.env.local; anon key is browser-safe) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
